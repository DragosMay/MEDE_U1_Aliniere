     0   #FFD300\n1  Common winter wheat        101      1    165    112      0   #A57000\n2   Temporal grassland        450     10    233    255    191   #E9FFBF\n2024 ['UTM_all_polygons_2024.shp']\n   n = 48 | crs None | tip geometrie ['Polygon'] | coloane ['crop_name', 'apia_code', 'label', 'rgb_r', 'rgb_g', 'rgb_b', 'hex_color', 'geometry']\n            crop_name  apia_code  label  rgb_r  rgb_g  rgb_b hex_color\n0         Sugar beets       3017      9    167      0    228   #A700E4\n1                Corn        108      3    255    211      0   #FFD300\n2  Temporal grassland        450     10    233    255    191   #E9FFBF\nyear                 2020  2021  2022  2023  2024\ncrop_name                                        \nAlfalfa_1               0     1     1     2     2\nAlfalfa_2               6     4     2     0     0\nCommon spring wheat     8     8     1     5     4\nCommon winter wheat    13     4     8     3     7\nCorn                    0     7     9    18    10\nCorn silage             6     7     9     0     0\nLate potatoes           0     2     1     2     4\nOther potato crop       2     0     0     1     0\nPeas                    0     1     1     5     2\nPermanent grassland     4     4     4     4     4\nPotatoes for seed       0     0     0     2     0\nSoybean                 4     0     5     0     0\nSugar beets             5     8     4     3     8\nSunflower               0     0     0     0     1\nTemporal grassland      2     2     2     2     2\nWinter rapeseed         1     4     0     0     4\nSentinel2_L2A_20210712.tif [1429. 1552. 1808. 1687. 2221. 3703. 4301. 4355. 4534. 4532. 3183. 2420.]\nCorect dacă a 8-a valoare (B8) e mult mai mare decât a 4-a (B4) și a 2-a (B2) e printre cele mai mici.\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code","source":"# STEP0 — 0b: CONFIGURARE + EXTRAGERE (după ce ai citit coloanele din 0a)\nfrom rasterio import features\n\nLABELS_DIR = f'{ROOT}/RoI_and_labels/UTM'\nS2_DIR     = f'{ROOT}/Images_Sentinel2_12bands_GeoTIFF'\nID_COL     = None            # <-- coloana cu id-ul parcelei (None = folosește indexul rândului)\nCROP_COL   = 'crop_name'     # confirmat din 0a (Corn, Soybean, Sugar beets, Common winter wheat, Temporal grassland)\nRED, NIR, BLUE = 4, 8, 2     # indecși 1-BASED (B4, B8, B2) — verifică în 0a că stiva are 12 benzi în ordinea B1..B12 fără B10\nBLUE_CLOUD = 0.15            # reflectanță medie B2 pe parcelă peste care o considerăm înnorată (calibrează!)\nBUFFER_M   = -10             # buffer negativ (m) ca să eviți pixelii de margine (UTM = metri)\nMIN_PIX    = 5               # minim de pixeli valizi pe parcelă\nMAX_IMAGES = None              # test: 5 imagini/an; pune None pentru tot\n\ndef parcel_means(lab, red, nir, blue, n):\n    \"\"\"NDVI mediu, B2 mediu și nr. de pixeli valizi pe parcelă (lab: 0 = fundal, 1..n = parcele).\"\"\"\n    ok = (lab > 0) & ((red + nir) > 0)\n    l = lab[ok]\n    cnt = np.bincount(l, minlength=n + 1).astype('float64')\n    nd = (nir[ok] - red[ok]) / (nir[ok] + red[ok])\n    s = np.bincount(l, weights=nd, minlength=n + 1)\n    b = np.bincount(l, weights=blue[ok], minlength=n + 1)\n    with np.errstate(invalid='ignore', divide='ignore'):\n        return s / cnt, b / cnt, cnt\n\nrows = []\nfor year in range(2020, 2025):\n    shp = glob.glob(f'{LABELS_DIR}/{year}/**/*.shp', recursive=True)\n    tifs = sorted(glob.glob(f'{S2_DIR}/**/Sentinel2_L2A_{year}*.tif*', recursive=True))\n    if MAX_IMAGES: tifs = tifs[:MAX_IMAGES]\n    if not shp or not tifs: print(year, 'lipsesc etichete sau imagini'); continue\n    gdf = pd.concat([gpd.read_file(f) for f in shp], ignore_index=True)\n    if gdf.crs is None:                       # shapefile-urile UTM nu au .prj; imaginile sunt EPSG:32635\n        gdf = gdf.set_crs('EPSG:32635')\n    gdf['pid'] = [f'{year}_{i}' for i in (gdf[ID_COL] if ID_COL else gdf.index)]\n    gdf['crop'] = gdf[CROP_COL].astype(str)\n    cache = {}\n    for f in tifs:\n        date = pd.to_datetime(re.search(r'(20\\d{6})', os.path.basename(f)).group(1))\n        with rasterio.open(f) as src:\n            key = (src.height, src.width, tuple(src.transform))\n            if key not in cache:\n                print(year, 'bounds poligoane', gdf.total_bounds.round(), '| bounds raster', tuple(round(v) for v in src.bounds))\n                g = gdf.to_crs(src.crs).copy()\n                g['geometry'] = g.geometry.buffer(BUFFER_M)\n                g = g[~g.geometry.is_empty].reset_index(drop=True)\n                print(year, 'parcele după buffer:', len(g), '/', len(gdf))\n                lab = features.rasterize(((geom, i + 1) for i, geom in enumerate(g.geometry)),\n                                         out_shape=(src.height, src.width), transform=src.transform,\n                                         fill=0, dtype='int32')\n                cache = {key: (g, lab)}\n            g, lab = cache[key]\n            red, nir, blue = src.read([RED, NIR, BLUE]).astype('float32')\n        if nir.max() > 2: red, nir, blue = red / 1e4, nir / 1e4, blue / 1e4      # DN -> reflectanță\n        nd, bl, cnt = parcel_means(lab, red, nir, blue, len(g))\n        keep = np.where((cnt[1:] >= MIN_PIX) & (bl[1:] <= BLUE_CLOUD))[0] + 1\n        rows += [(g.pid[i-1], g.crop[i-1], date, float(nd[i])) for i in keep]\n        print(year, date.date(), 'parcele valide:', len(keep), '/', len(g))\n\nnd_long = pd.DataFrame(rows, columns=['parcel_id', 'crop', 'date', 'ndvi'])\nprint(nd_long.ndvi.describe())            # NDVI plauzibil: ~0.1–0.9\nnd_long.to_csv('ndvi_long.csv', index=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-15T21:14:37.044816Z","iopub.execute_input":"2026-11-15T21:14:37.045215Z","iopub.status.idle":"2026-11-15T21:15:42.859229Z","shell.execute_reply.started":"2026-11-15T21:14:37.045183Z","shell.execute_reply":"2026-11-15T21:15:42.857975Z"}},"outputs":[{"name":"stdout","text":"2020 bounds poligoane [ 383635. 5057675.  387565. 506